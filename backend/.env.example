# Copy to backend/.env and fill in real values. Never commit the real file.
# Replace every CHANGE_ME value before a non-development boot. Config checks
# AUDIT_LOG_SALT length and TAKEAWAY_ENCRYPTION_KEY validity, but it does not
# yet reject CHANGE_ME placeholders by prefix.

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_AUTH_KEY=your-supabase-anon-or-auth-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Server-only. Required for email poller writes (bypasses RLS). Never expose
# to the frontend. Leave blank when email OAuth is off.
SUPABASE_SERVICE_ROLE_KEY=

# ── Runtime ──────────────────────────────────────────────────────────────────
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173

# ── Gemini (AI recommendations and chat) ─────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
# gemini-2.5-flash shuts down on 2026-12-01 (ai.google.dev deprecations page).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_CONTEXT_TOKEN_BUDGET=900
GEMINI_CIRCUIT_BREAKER_FAILURES=3
GEMINI_CIRCUIT_BREAKER_RESET_SECONDS=120

# ── Rate limits (per client IP, sliding window) ──────────────────────────────
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
TASKS_RATE_LIMIT_REQUESTS=120
TASKS_RATE_LIMIT_WINDOW_SECONDS=60
NOTES_RATE_LIMIT_REQUESTS=120
NOTES_RATE_LIMIT_WINDOW_SECONDS=60

# ── Auth cookies ─────────────────────────────────────────────────────────────
ACCESS_COOKIE_NAME=nexus-access-token
REFRESH_COOKIE_NAME=nexus-refresh-token
ACCESS_COOKIE_MAX_AGE=900
REFRESH_COOKIE_MAX_AGE=604800
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ── Email (optional OAuth; the feature stays off when both client IDs are blank)
EMAIL_POLL_INTERVAL_SECONDS=60
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# ── Secrets (replace every CHANGE_ME value; generate with a CSPRNG) ──────────
# AUDIT_LOG_SALT: any long random string (32+ characters), for example
# `openssl rand -hex 32`. The placeholder is deliberately shorter than the
# 32-character minimum, so a production boot with it fails closed.
AUDIT_LOG_SALT=CHANGE_ME
# TAKEAWAY_ENCRYPTION_KEY: a Fernet key, for example
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TAKEAWAY_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX

# ── Observability ────────────────────────────────────────────────────────────
BACKEND_SENTRY_DSN=
BACKEND_SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Networking ───────────────────────────────────────────────────────────────
# Redis backs the rate limiter across processes. Optional for a single worker.
REDIS_URL=
# Comma-separated IPs of proxies whose X-Forwarded-For is trusted.
TRUSTED_PROXY_IPS=
# How the client IP is read from X-Forwarded-For: leftmost (default; the
# Worker overwrites the header) or rightmost (needs every proxy hop, including
# Cloudflare edge ranges, in TRUSTED_PROXY_IPS). See docs/operations.md.
CLIENT_IP_STRATEGY=leftmost
